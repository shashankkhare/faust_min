// =============================================================================
// fm.lib — Sitar String Jawari Waveguide Engine
//
// Defines `sitar_string`, a digital waveguide string with an asymmetric
// tanh jawari waveshaper in the feedback loop. Shared by sitar.dsp,
// sarod.dsp and tanpura.dsp.
//
// =============================================================================
// DESIGN
// =============================================================================
//
// Modified Karplus-Strong waveguide with 5 stages:
//
//   1. DELAY LINE          → integer + fractional (cubic Lagrange, fdelayltv)
//   2. WIRE LOSS FILTER    → one-pole lowpass (high-freq decay)
//   3. JAWARI NONLINEARITY → asymmetric tanh with pre-gain (harmonic generation)
//   4. FEEDBACK GAIN       → exponential decay from sustain time
//   5. TIME-VARYING MOD    → fdelayltv with envelope-following depth
//
// ── 3. Jawari ──────────────────────────────────────────────────────────────
//    ba.if(x > 0.0,
//        tanh(x * (1 + jv*2)) / (1 + jv*2),     // upward: near-linear
//        tanh(x * (1 + jv*20)) / (1 + jv*20)    // downward: hard clip
//    );
//    Pre-gain drives the downward wave into tanh hard-clipping, generating
//    rich odd harmonics. The clean upward wave mixes with the distorted
//    downward wave to produce even harmonics → characteristic sitar buzz.
//    Bounded by tanh, stable in feedback loop. Normalized denominator
//    keeps net gain near unity.
//
// =============================================================================
// PARAMETERS
// =============================================================================
//   f           — fundamental frequency in Hz
//   sus_time    — target sustain in seconds (jawari shortens it)
//   jivari_val  — jawari intensity [0..1]
//   exc_gain    — gain on the injected excitation
//   trigger     — gate (0/1); enables excitation injection
//   exc_signal  — noise/impulse driving the string
//   cal         — pitch calibration in cents (0=no shift, ±100 max)
//
// =============================================================================
// DEPENDENCIES
// =============================================================================
//   stdfaust.lib — ma.SR, de.delay, de.fdelayltv,
//                  an.amp_follower, os.osc, ma.tanh
//
// =============================================================================

// ===================================================================
// sitar_string — waveguide string with asymmetric tanh jawari
// ===================================================================
sitar_string(f, sus_time, jivari_val, exc_gain, trigger, exc_signal, cal) = melody_output
with {
    cfreq = f * pow(2, cal/1200);

    // 1. Delay: integer + fractional for pitch accuracy
    del = ma.SR / max(40.0, cfreq);
    int_del = int(del);
    frac_del = del - int_del;

    // 2. Wire loss + sustain
    effective_sustain = max(0.4, sus_time * (1.0 - jivari_val * 0.35));
    feedback_gain = pow(0.001, del / (effective_sustain * ma.SR));
    wire_loss_filter(x) = x * 0.002 + x' * 0.998;

    // 3. Asymmetric tanh jawari — downward wave gets pre-gain into hard clip
    // Interpolates linear (jivari=0) <-> original soft-clipper (jivari=1),
    // so small-signal gain stays 1.0 at every jivari and sustain is preserved.
    jawariInLoop(x) = ba.if(x > 0.0,
        x,
        x - jivari_val * (x - ma.tanh(x * (1.0 + jivari_val * 20.0)) / (1.0 + jivari_val * 20.0))
    );

    // 4. Feedback loop
    raw_wave = (exc_signal * exc_gain * trigger) : (+ : de.delay(16384, int_del - 1)) ~ loop_processor
    with {
        loop_processor(x) = de.fdelayltv(3, 1024, 1.0 + frac_del, x) : wire_loss_filter : jawariInLoop : * (feedback_gain);
    };

    // 5. Envelope-following time-varying modulation
    string_envelope = raw_wave : an.amp_follower(0.030);
    mod_depth = (300.0 / max(40.0, cfreq)) * jivari_val * 4.5 * string_envelope;
    external_modulator = os.osc(cfreq) * mod_depth;

    melody_output = de.fdelayltv(1, 1024, max(1.0, 4.0 + external_modulator), raw_wave);
};

// ===================================================================
// fluteModel — cylindrical bore waveguide (Western classical flute)
// ===================================================================
//
// Noise-excited digital waveguide for a cylindrical tube with a DC-
// blocking highpass in the feedback path to suppress subharmonics.
// Supports both open-open (flute, f = v/2L) and open-closed
// (clarinet, f = v/4L) configurations via the `mode` parameter.
//
// DESIGN
// ===================================================================
//
// Open-open tube:     delay = SR / freq   (full period, f = v/2L)
// Open-closed tube:   delay = SR / (freq * 2) (half period, f = v/4L)
//
//   1. DELAY LINE — integer + fractional (fdelay1a allpass)
//   2. NOISE EXCITATION — white noise highpassed at freq*0.5 to
//      suppress subharmonic buildup; gain scaled by pressure × breathEnv
//   3. FEEDBACK — fixed per-sample gain (0.999); ~3% loss/cycle at 440 Hz
//   4. DC BLOCKER — first-order highpass at 15 Hz in feedback path to
//      prevent DC accumulation without detuning the fundamental
//
// PARAMETERS
// ===================================================================
//   freq        — target fundamental frequency in Hz (before calibration)
//   pressure    — breath pressure [0..1]; scales noise injection level
//   breathEnv   — continuous breath envelope signal (0 = silent, 1 = full)
//   mouthPos    — embouchure position [0..1]; NOT USED in current model
//   loss        — tube loss [0..1]; NOT USED in current model (fixed gain)
//   mode        — 0 = open-open (flute), 1 = open-closed (clarinet)
//   cal         — pitch calibration in cents (±100 max); cfreq = freq × 2^(cal/1200)
//
// ===================================================================
// CALIBRATION
// ===================================================================
//
// Self-calibrating via pitchcorrect.py. Uses `<instrument_name>_calibration`
// column in CSV. Calibration model: `cents`, where `cfreq = freq × 2^(cal/1200)`.
//
// ===================================================================
// DEPENDENCIES
// ===================================================================
//   stdfaust.lib — ma.SR, de.delay, de.fdelay1a, no.noise,
//                  fi.highpass, fi.lowpass, fi.dcblocker, tanh
//
// ===================================================================

fluteModel(freq, pressure, breathEnv, mouthPos, loss, cal, jetDelBias, jetDelScale) = output
with {
    // 1. BASE TARGET PERIOD (in samples)
    target_period = ma.SR / max(40.0, freq);

    // 2. PRECISION CALIBRATION ENGINE
    // We apply your 'cal' slider/parameter directly to the acoustic period.
    // Negative cal values lengthen the tube (lower pitch), positive values shorten it (raise pitch).
    calibrated_period = target_period * pow(2.0, -cal / 1200.0);

    // The pitch trim has to move the WHOLE loop, not just the bore. The loop
    // lowpass below is what sets the mode selection, and its group delay is a
    // fixed number of samples; if the cutoff stayed tied to the raw request,
    // that fixed delay would dilute every cent of `cal` to roughly half its
    // nominal value (measured: 182 cents of cal bought ~69 cents at 698 Hz).
    // Tying the cutoff to the calibrated frequency keeps the cutoff/oscillation
    // ratio -- and therefore the timbre -- constant across the trim range.
    calibrated_freq = freq * pow(2.0, cal / 1200.0);

    // Half-wave acoustic bore calculation with fixed filter group-delay offset (~2.5 samples)
    bore_del = (calibrated_period * 0.5) - 2.5;

    // 3. JET PRE-DELAY
    // Split into a fixed offset plus a mouth-position term so flute.dsp and
    // bansuri.dsp can share this model while keeping their own embouchure feel.
    jet_del = (calibrated_period * 0.5) * max(0.02, jetDelBias + (mouthPos * jetDelScale));

    // Isolate integer and fractional parts for the main bore tracking
    int_bore = int(bore_del);
    frac_bore = bore_del - int_bore;

    // Stable wall loss lowpass parameters
    wall_cutoff = 8500.0 - (loss * 6500.0);
    g_wall = 0.990 - (loss * 0.04);

    // Mode-selective loop cutoff. The odd bore modes sit near 1x/3x/5x the
    // fundamental, so rolling the loop off above roughly 3.5x f keeps the 3rd
    // mode well under unity while the fundamental stays above it.
    mode_cutoff = min(wall_cutoff, max(calibrated_freq * 2.5, 100.0));

    // Valve hardness. This is the drive that pushes the jet curve into its
    // saturating knee, and with it the amount of 3rd-harmonic energy fed back
    // into the bore. Lower values keep the valve closer to linear, so less
    // energy reaches the 3rd bore mode; higher values make it easier for that
    // mode to latch and bring the crack back.
    jet_k = 0.35;

    // Loop gain referenced to the wall loss, so the oscillator holds a constant
    // margin above unity at every loss setting instead of drifting with cutoff.
    //
    // The margin must stay low enough that the 3rd bore mode cannot sustain: at
    // 1.7 the 1st mode sits ~1.6 above unity while the 3rd sits ~0.8, a 6 dB
    // separation. At the old 2.0 the 3rd mode reached ~1.07 and latched onto
    // 2.4x the request on 150/155/165/220 Hz -- the crack in its last form.
    jet_gain = 1.7 / g_wall;

    // Streamlined Excitation Architecture
    dynamic_noise_gain = 0.20 + (pow(mouthPos, 2.0) * 0.10);

    // Bounded jet drive: blowing harder must never push the valve curve so deep
    // into saturation that its incremental gain falls below unity and kills the
    // note. Unbounded drive did exactly that above pressure ~1.1.
    breath_drive = 0.5 * ma.tanh((pressure * breathEnv) / 0.5);
    noise = no.noise : fi.highpass(2, max(40.0, freq * 0.6));
    noise_injection = noise * breath_drive * dynamic_noise_gain;
    excitation = breath_drive + noise_injection;

    // Physical interaction loop at the labium split point.
    //
    // The bore reflection enters through the jet pre-delay ONLY. Subtracting it a
    // second time directly made this a two-tap positive comb with ~2x loop gain,
    // which left the 1st/3rd/5th modes nearly degenerate (+5.7/+5.5/+4.8 dB). The
    // loop then latched onto whichever mode the attack transient favoured -- 0.5x,
    // 1.4x or 2.85x the requested pitch -- and being ~1.6x louder than the intended
    // mode it drove the old clipper into hard clip. That was the low-register crack.
    flute_loop(bore_reflection) = net_pressure
    with {
        delayed_jet = excitation - bore_reflection : de.delay(16384, int(jet_del));

        // Monotone valve curve. Small-signal gain is jet_gain (> 1, so the loop
        // sustains itself) and the slope decays smoothly to zero as the drive
        // grows, which is what sets the steady-state amplitude. The old x - x^3/3
        // saturator had slope 1 - x^2, never above 1, so it could not sustain the
        // loop at all -- that is why the extra tap existed. Being monotone, this
        // curve also never folds back, so it cannot reintroduce the crack.
        safety = max(-1.5, min(1.5, delayed_jet));
        jet_wave = jet_gain * ma.tanh(jet_k * safety) / jet_k;

        // Micro-stimulus: We leak a tiny fraction of raw breath excitation past the clip.
        // This acts as an acoustic spark plug to restart the engine if it ever breaks down.
        recovery_stimulus = excitation * 0.0001;

        net_pressure = jet_wave + recovery_stimulus;
    };
    // Main acoustic body loop containing precise fractional reflections
    raw_wave = flute_loop ~ (
        de.delay(16384, int_bore)
        : de.fdelay1a(1024, frac_bore)
        : fi.dcblocker
        : fi.lowpass(2, mode_cutoff)
        : * (g_wall)
    );

    output = raw_wave;
};


